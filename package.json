{
  "name": "nuxt-squish-app",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:components": "vitest run test/unit/components",
    "test:composables": "vitest run test/unit/composables",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:e2e": "nuxt generate && playwright test",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "@nuxt/ui": "^3.0.0",
    "nuxt": "^4.4.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.133",
    "@nuxt/eslint": "^1.0.0",
    "@nuxt/icon": "^1.10.2",
    "@nuxtjs/seo": "^4.0.2",
    "@playwright/test": "^1.65.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4",
    "@vitest/ui": "^4",
    "@vue/test-utils": "^2.4.0",
    "chalk": "^5.3.0",
    "eslint": "^9.18.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35",
    "typescript": "^5.7.3",
    "vitest": "^4",
    "vitest-canvas-mock": "^0.3.0",
    "vue-tsc": "^2.2.0"
  }
